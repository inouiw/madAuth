{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8787
    },
    {
      "name": "webhooks",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../madAuth-webhooks/dev-receiver",
        "run",
        "dev"
      ],
      "port": 8790
    }
  ]
}
