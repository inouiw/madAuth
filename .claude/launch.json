{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8787
    },
    {
      "name": "webhooks",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run dev --prefix \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/../madAuth-webhooks/dev-receiver\""
      ],
      "port": 8790
    }
  ]
}
