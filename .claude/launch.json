{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "demo-built",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export DEMO_BASE=/demo/ && npm run build -w demo && npm run preview -w demo -- --port 4173 --strictPort"
      ],
      "port": 4173
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "site"
      ],
      "port": 3001
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8787
    },
    {
      "name": "webhooks",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run dev --prefix \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/../madAuth-webhooks/dev-receiver\""
      ],
      "port": 8790
    }
  ]
}
