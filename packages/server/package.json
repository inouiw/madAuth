{
  "name": "@madauth/server",
  "version": "0.7.0-beta.3",
  "description": "madAuth server: Google, GitHub, OpenID Connect, e-mail & password, e-mail link, passkey, authenticator-app and SMS-code sign-in with madAuth sessions, for Node, Docker, AWS Lambda and Azure Functions.",
  "license": "MIT",
  "author": "David Neuy",
  "homepage": "https://github.com/inouiw/madAuth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inouiw/madAuth.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/inouiw/madAuth/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "login",
    "sign-in",
    "google-sign-in",
    "oidc",
    "passkeys",
    "webauthn",
    "totp",
    "2fa",
    "session",
    "jwt",
    "hono",
    "aws-lambda",
    "azure-functions",
    "dynamodb",
    "postgres",
    "sqlite",
    "aws-kms"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./dynamodb": {
      "types": "./dist/store/dynamodb.d.ts",
      "import": "./dist/dynamodb.js"
    },
    "./postgres": {
      "types": "./dist/store/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./aws-kms": {
      "types": "./dist/kms.d.ts",
      "import": "./dist/aws-kms.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    },
    "./node": {
      "types": "./dist/entry/node.d.ts",
      "import": "./dist/entry/node.js"
    },
    "./lambda": {
      "types": "./dist/entry/lambda.d.ts",
      "import": "./dist/entry/lambda.js"
    },
    "./azure": {
      "types": "./dist/entry/azure.d.ts",
      "import": "./dist/entry/azure.js"
    }
  },
  "bin": {
    "madauth-server": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/standalone/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-key": "tsx src/bin.ts generate-key",
    "cli": "tsx --env-file-if-exists=.env src/bin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@simplewebauthn/server": "^14.0.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-kms": "^3.0.0",
    "@aws-sdk/credential-provider-node": "^3.0.0",
    "@azure/functions": "^4.0.0",
    "@smithy/signature-v4": "^5.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@aws-sdk/credential-provider-node": {
      "optional": true
    },
    "@azure/functions": {
      "optional": true
    },
    "@smithy/signature-v4": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "@azure/functions": "^4.16.5",
    "@smithy/signature-v4": "^5.7.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
