# Copy to .env (git-ignored) and adjust. See docs/server.md.

# Public base URL of the server. In development the demo proxies /auth to this server, so it is the demo's URL.
MADAUTH_ISSUER=http://localhost:3000
# Private ES256 JWK. Leave unset once: the start-up error prints a freshly generated key.
MADAUTH_SIGNING_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# Google sign-in. Web client from the capacitor-native-google-one-tap-signin demo (origins http://localhost:3000 and http://localhost).
GOOGLE_CLIENT_ID=333448133894-m88bqcrq93ao7vi2j4o475fnlbsnhc9g.apps.googleusercontent.com
# Optional: enables the redirect flow (GoogleRedirect). Never commit it.
GOOGLE_CLIENT_SECRET=
# GitHub sign-in: an OAuth App from https://github.com/settings/developers with the callback URL
# http://localhost:3000/auth/github/callback. Both or neither; never commit the secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The authenticator app needs no setting; admins switch it on in the settings (Madauth.admin.setSettings). Optional: the
# name users see next to the account in their app. Default: the host of your app.
#AUTHENTICATOR_ISSUER=
# Passkeys need no setting either; admins switch them on in the settings. Optional: the domain they belong to, e.g.
# example.com for the apps on all its subdomains. Default: the host of your app. Set it before users add passkeys.
#PASSKEY_RP_ID=
# Every user is stored here, whichever way they sign in: this SQLite file (docker-compose uses sqlite:/data/madauth.db).
# On AWS: dynamodb:<table>, see "DynamoDB" in docs/server.md.
DATABASE_URL=sqlite:./madauth.db
# The first admin: who signs in with this address, once it is proven, gets the role admin and can use the demo's admin
# panel. Once per value: a new value makes another admin. See "The first admin" in docs/server.md.
#INITIAL_ADMIN_EMAIL=you@example.com
# E-mail & password sign-in: madAuth hands its e-mails to this webhook. In development, run the dev-receiver of
# https://github.com/inouiw/madAuth-webhooks: it prints them (with links and codes).
WEBHOOK_URL=http://localhost:8790/webhook
# Leave empty once: the start-up error prints a freshly generated secret. Your receiver needs the same one.
WEBHOOK_SECRET=
# The types the receiver handles; only these are sent. E-mail & password sign-in is on when email.send_verification and email.send_password_reset
# are among them; the passwordless e-mail link needs email.send_signin_link; sign-up with the authenticator app or a passkey alone needs email.send_verification;
# SMS codes as a second factor need sms.send_code (the receiver sends the SMS). The development receiver prints all of them.
WEBHOOK_EVENTS=email.send_verification,email.send_password_reset,email.send_signin_link,email.send_already_registered,email.send_password_reset_no_password,sms.send_code,user.signing_up,user.signed_up,user.email_verified,user.password_reset,user.signed_in,user.deleted,user.claims_changed,user.second_factor_enabled,user.second_factor_disabled,user.recovery_code_used,user.method_added,user.method_removed,user.sign_in_reset
PORT=8787
