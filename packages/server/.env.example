# Copy to .env (git-ignored) and adjust. See docs/server.md.

# Public base URL of the server. In development the demo proxies /auth to this server, so it is the demo's URL.
MADAUTH_ISSUER=http://localhost:3000
# Where madAuth keeps its keys: local (MADAUTH_SIGNING_KEY, in the server's memory) for development; in production
# aws-kms, where they never leave AWS KMS. See "Key service" in docs/server.md.
MADAUTH_KEY_SERVICE=local
# Private ES256 JWK, for MADAUTH_KEY_SERVICE=local. Leave unset once: the start-up error prints a freshly generated key.
MADAUTH_SIGNING_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# Google and GitHub sign-in are providers in the store, not settings here: until the first admin exists, the server
# prints a setup token at the start, with which you add them (POST /auth/admin/providers/add); later an admin does it
# in the demo (Madauth.admin.addProvider). See "Providers" in docs/server.md. For development: the Google web client
# 333448133894-m88bqcrq93ao7vi2j4o475fnlbsnhc9g.apps.googleusercontent.com (from the capacitor-native-google-one-tap-signin
# demo, origins http://localhost:3000 and http://localhost) works for One Tap; a GitHub OAuth App from
# https://github.com/settings/developers needs the callback URL http://localhost:3000/auth/providers/github/callback.
# The authenticator app needs no setting; admins switch it on in the settings (Madauth.admin.setSettings). Optional: the
# name users see next to the account in their app. Default: the host of your app.
#AUTHENTICATOR_ISSUER=
# Passkeys need no setting either; admins switch them on in the settings. Optional: the domain they belong to, e.g.
# example.com for the apps on all its subdomains. Default: the host of your app. Set it before users add passkeys.
#PASSKEY_RP_ID=
# Every user is stored here, whichever way they sign in: this SQLite file (docker-compose uses sqlite:/data/madauth.db).
# Postgres: postgres://<user>:<password>@<host>:5432/<database>, see "Postgres" in docs/server.md.
# On AWS: dynamodb:<table>, see "DynamoDB" in docs/server.md.
DATABASE_URL=sqlite:./madauth.db
# Postgres only: false if the database user may not create or change tables; madAuth then only checks them.
#DATABASE_MIGRATE=false
# API keys: where your app lists the scopes of its API, which users can give their keys next to madAuth's own. The
# demo lists example scopes in demo/public/api-scopes.json. See docs/api-keys.md.
#API_KEY_SCOPES_URL=http://localhost:3000/api-scopes.json
# The first admin: who signs in with this address, once it is proven, gets the role admin and can use the demo's admin
# panel. Once per value: a new value makes another admin. See "The first admin" in docs/server.md.
#INITIAL_ADMIN_EMAIL=you@example.com
# E-mail & password sign-in: madAuth hands its e-mails to this webhook. In development, run the dev-receiver of
# https://github.com/inouiw/madAuth-webhooks: it prints them (with links and codes).
WEBHOOK_URL=http://localhost:8790/webhook
# Leave empty once: the start-up error prints a freshly generated secret. Your receiver needs the same one.
WEBHOOK_SECRET=
# On AWS, for a receiver behind a Lambda Function URL with AWS_IAM auth: madAuth signs the calls with its AWS role
# instead (without WEBHOOK_SECRET). See "AWS IAM" in docs/server.md.
#WEBHOOK_AUTH=aws-iam
# The types the receiver handles; only these are sent. E-mail & password sign-in is on when email.send_verification and email.send_password_reset
# are among them; the passwordless e-mail link needs email.send_signin_link; sign-up with the authenticator app or a passkey alone needs email.send_verification;
# SMS codes as a second factor need sms.send_code (the receiver sends the SMS). The development receiver prints all of them.
WEBHOOK_EVENTS=email.send_verification,email.send_password_reset,email.send_signin_link,email.send_already_registered,email.send_password_reset_no_password,sms.send_code,user.signing_up,user.signed_up,user.email_verified,user.password_reset,user.signed_in,user.deleted,user.claims_changed,user.second_factor_enabled,user.second_factor_disabled,user.recovery_code_used,user.method_added,user.method_removed,user.sign_in_reset,user.api_key_created,user.api_key_revoked
PORT=8787
