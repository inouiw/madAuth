{
  "name": "@madauth/web",
  "version": "0.1.0",
  "description": "madAuth sign-in UI as framework-agnostic web components.",
  "license": "MIT",
  "author": "David Neuy",
  "homepage": "https://github.com/inouiw/madAuth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inouiw/madAuth.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/inouiw/madAuth/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "login",
    "sign-in",
    "google-sign-in",
    "fedcm",
    "web-components",
    "lit"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
